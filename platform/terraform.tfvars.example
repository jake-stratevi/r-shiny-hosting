region  = "us-east-1"
project = "shiny"

route53_zone_id = "Z0123456789ABCDEFGHIJ"
domain_name     = "tools.example.com"

# This stack CREATES its own user pool (ADR-0015, superseding ADR-0007), so
# there is no pool id to supply -- only the hosted-UI domain prefix. It must
# be globally unique across all AWS accounts, lowercase, and must not contain
# "aws", "amazon" or "cognito". Check before you apply:
#
#   aws cognito-idp describe-user-pool-domain --domain stratevi-shinyplatform
cognito_domain_prefix = "REPLACE-ME"

# Leave unset. "COGNITO" (the default) means the pool's own native directory
# and no federation, which is what a fresh pool has. Set it to an identity
# provider's name only after federating one INTO this pool:
#
#   aws cognito-idp list-identity-providers --user-pool-id <id> --query "Providers[].ProviderName" --output table
# cognito_staff_idp_name = "Microsoft365"

alb_idle_timeout = 3600

monthly_budget_usd  = 75
budget_alert_emails = ["you@example.com"]

# alb_allowed_cidrs = ["203.0.113.0/24"]

# Prefer TF_VAR_oidc_provider over putting the secret in this file.
# oidc_provider = {
#   name          = "EntraID"
#   issuer        = "https://login.microsoftonline.com/<tenant-id>/v2.0"
#   client_id     = "<client-id>"
#   client_secret = "<secret>"
#   scopes        = "openid profile email"
# }
