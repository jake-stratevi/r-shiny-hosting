region  = "us-east-1"
project = "shiny"

route53_zone_id = "Z0123456789ABCDEFGHIJ"
domain_name     = "tools.example.com"

# The EXISTING Assembled Hub pool -- we do not create one.
# See docs/adr/0007-reuse-hub-cognito-pool.md.
#
#   aws cognito-idp describe-user-pool --user-pool-id us-east-1_6vtAiYEpv --query "UserPool.Domain" --output text
#   aws cognito-idp list-identity-providers --user-pool-id us-east-1_6vtAiYEpv --query "Providers[].ProviderName" --output table
cognito_user_pool_id     = "us-east-1_6vtAiYEpv"
cognito_hosted_ui_domain = "REPLACE-ME"   # prefix only, from the first command
cognito_staff_idp_name   = "Microsoft365" # confirm with the second

alb_idle_timeout = 3600

monthly_budget_usd  = 75
budget_alert_emails = ["you@example.com"]

# alb_allowed_cidrs = ["203.0.113.0/24"]

# Prefer TF_VAR_oidc_provider over putting the secret in this file.
# oidc_provider = {
#   name          = "EntraID"
#   issuer        = "https://login.microsoftonline.com/<tenant-id>/v2.0"
#   client_id     = "<client-id>"
#   client_secret = "<secret>"
#   scopes        = "openid profile email"
# }
